APP_NAME=Laravel
# APP_ENV=local or production
APP_ENV=local 
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOWNLOADS_URL=https://www.filipinohomes.com/app/downloads

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filipinohomes_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_API_KEY=

# HOMESPHNEWS_BASE_URL=https://homesphnews-api-394504332858.asia-southeast1.run.app/api
HOMESPHNEWS_BASE_URL=https://api.homes.ph/api
HOMESPHNEWS_API_KEY=ffPr9SfixF32Xn18878QkGm0y5fAnOnYAzH719K3C60b2t2EKf84mVtq7eokV5HD

PDF_OPTIMIZATION_ENABLED=true
GHOSTSCRIPT_BINARY=gs
GHOSTSCRIPT_PDFSETTINGS=/ebook
GHOSTSCRIPT_TIMEOUT=180

# ── IndexNow integration ─────────────────────────────────────────────
# Enable Laravel-side IndexNow pinging on listing / agent / blog /
# project create / update / delete events. The actual HTTP POST is
# performed by the Next.js layer (the IndexNow key file lives there).
INDEXNOW_ENABLED=false
INDEXNOW_SUBMIT_URL=https://filipinohomes.com/api/indexnow/submit
INDEXNOW_SUBMIT_SECRET=
INDEXNOW_SITE_URL=https://filipinohomes.com
INDEXNOW_TIMEOUT=8
INDEXNOW_QUEUE=default


# Trusted token sent by the Next.js build server to bypass the per-IP rate
# limiter during SSG production builds (~400 pages × 5 API calls each).
# Generate with: openssl rand -hex 32
# Must match BUILD_API_TOKEN in the Next.js Vercel environment variables.
BUILD_API_TOKEN=

# Expo Push Service access token. Only needed if "Enhanced Security for Push
# Notifications" is enabled on the Expo project; leave blank otherwise.
EXPO_ACCESS_TOKEN=

FH_AGENT_API_SECRET=openssl rand -hex 32

# Generate image variants for all existing images. Use --dry-run to preview the changes without actually modifying any files. Use --limit to limit the number of images processed in one run.
# php artisan images:generate-variants --dry-run --limit=1 


# ── Automated YouTube listing videos (youtube:process-uploads) ──────────────
# OAuth credentials for the FilipinoHomes brand channel (Google Cloud project
# with YouTube Data API v3 enabled; refresh token minted once by the team,
# authorized with BOTH scopes: youtube.upload AND youtube.force-ssl — the
# latter is required for the auto-generated caption track).
# NOTE: until the API project passes YouTube's compliance audit, uploaded
# videos are LOCKED PRIVATE by YouTube.
YOUTUBE_UPLOADS_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Hard daily ceiling (4 fits the historical 10k-unit default: ~2,050 units per
# full upload incl. thumbnail + caption; check the real videos.insert
# allowance in the Google Cloud console before raising).
YOUTUBE_DAILY_UPLOAD_CAP=4
# Where /og/listing-video card PNGs are rendered (defaults to FRONTEND_URL).
# YOUTUBE_OG_BASE=https://filipinohomes.com
# YOUTUBE_FFMPEG_BIN=ffmpeg

# ── NATCON 2026 convention campaign ─────────────────────────────────────────
# HMAC key for awardee invite links. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Rotating this invalidates every outstanding invite link — don't, mid-campaign.
NATCON_LINK_SECRET=
# off | whitelist | live. Ships as `off`: rows are still claimed in
# natcon_outbox so a dry run exercises the real path, but nothing is sent.
NATCON_SEND_MODE=off
# Comma-separated addresses that receive everything while SEND_MODE=whitelist.
NATCON_TEST_RECIPIENTS=
# Emails drained per scheduler tick. Production has no queue:work worker, so
# sending is paced by the cron that already runs.
NATCON_DRAIN_LIMIT=40
# Max send attempts before an outbox row settles as failed.
NATCON_MAX_SEND_ATTEMPTS=3
# How long an invite link stays valid past the photo deadline. A hard expiry on
# the deadline turns every late click into a dead link and a support ticket.
NATCON_TOKEN_GRACE_DAYS=14
# Leuterio Realty awardee lookup. They rate-limit to 60/min per source IP, so we
# self-throttle to half that to leave headroom for other LR integrations on the
# same egress IP. NOTE: a miss is HTTP 200 with {"success":false}, not a 404.
NATCON_LR_BASE_URL=https://api.leuteriorealty.com/natcon/v1/public/api/v2/get-awardee
NATCON_LR_TIMEOUT=15
NATCON_LR_RATE=30
# Fallbacks only — the S3 prefix and email banner are per-event columns now, so a
# new convention year cannot inherit the previous year's folder or artwork.
# NATCON_S3_PREFIX=
# NATCON_EMAIL_BANNER_URL=

# Photos per awardee: the minimum that completes a submission, and the ceiling.
# The ask reads as a range whenever they differ — "send 1-3 photos".
NATCON_PHOTO_REQUIRED_COUNT=1
NATCON_PHOTO_MAX_COUNT=3

# Leuterio Realty's bulk qualifiers list — the awardee roster.
# The three dates are the QUALIFYING SALES WINDOW and change every convention
# year; they are here rather than in code so the window moves without a deploy.
NATCON_LR_QUALIFIERS_URL=https://leuteriorealty.com/api/natcon-qualifiers-v2
NATCON_LR_QUALIFIERS_FROM=2025-08-01
NATCON_LR_QUALIFIERS_LASTDATE_X=2026-07-31
NATCON_LR_QUALIFIERS_LASTDATE_Y=2026-08-05
